{
  "name": "emc-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node tools/check-links.mjs && node tools/check-detail-parity.mjs && node tools/check-scope.mjs && node tools/check-physics.mjs",
    "test": "node tools/smoke-test.mjs",
    "check:physics": "node tools/check-physics.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i css/input.css -o css/site.css --minify",
    "build:public": "node tools/build-public.mjs",
    "build": "bun run build:css && bun run build:public",
    "test:shell": "node tools/shell-stress.mjs",
    "test:interact": "node tools/interaction-test.mjs",
    "loader-verify": "node tools/loader-verify.mjs",
    "nav-verify": "node tools/nav-verify.mjs",
    "quiz-verify": "node tools/quiz-verify.mjs",
    "lecture-values": "node tools/lecture-values.mjs",
    "a11y-verify": "node tools/a11y-verify.mjs",
    "intro-verify": "node tools/intro-verify.mjs",
    "ui-verify": "node tools/ui-verify.mjs",
    "sim-verify": "node tools/sim-verify.mjs",
    "responsive-verify": "node tools/responsive-verify.mjs",
    "motion-verify": "node tools/motion-verify.mjs",
    "asset-verify": "node tools/asset-verify.mjs",
    "stability-stress": "node tools/stability-stress.mjs",
    "verify:prod": "node tools/prod-verify.mjs",
    "test:browsers": "node tools/browser-matrix.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  },
  "devDependencies": {
    "jsdom": "^27.4.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^3.4.19"
  },
  "description": "Interactive electromagnetics tutorial for Calculus-based Physics II. Fully static: zero runtime dependencies; jsdom is a dev-only test dependency."
}
