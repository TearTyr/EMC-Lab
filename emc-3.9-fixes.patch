-  console.log(`${path.padEnd(24)} ${kb(m.total)}  ${kb(m.fontBytes)}  ${(m.dcl + 'ms').padStart(6)}  ${m.blocking}`);
-  if (m.blocking > 0) fails.push(`${path}: ${m.blocking} render-blocking script(s)`);
