-const MIME = { '.html': 'text/html', '.css': 'text/css', '.js': 'text/javascript',
-  '.svg': 'image/svg+xml', '.woff2': 'font/woff2', '.ttf': 'font/ttf',
-  '.json': 'application/json', '.md': 'text/markdown', '.sql': 'text/plain' };
